# aBangumi auth BFF — example environment.
# Copy to `.env` and fill in real values. Never commit a real client secret.

# Bangumi OAuth application ID (public, safe to ship in the app too).
BANGUMI_CLIENT_ID=bgm69386a8765324f840

# Bangumi OAuth client secret. REQUIRED and MUST be kept secret.
# Leave blank here — set a real value only in your deployment environment.
BANGUMI_CLIENT_SECRET=

# Public base URL of this BFF (the HTTPS URL the browser/bangumi will hit).
# Must be https:// except for localhost/127.0.0.1 development.
PUBLIC_BASE_URL=https://auth.example.com

# Custom scheme the app listens on for the callback redirect.
APP_CALLBACK_URI=abangumi://oauth/callback

# Port the BFF listens on (behind a TLS-terminating reverse proxy).
PORT=8787

# Optional: browser CORS origin. Leave unset to allow no cross-origin reads.
# CORS_ORIGIN=https://app.example.com

# TTLs (advanced). Defaults are the protocol limits.
# STATE_TTL_MS=300000
# TICKET_TTL_MS=60000
# SESSION_TTL_MS=2592000000   # 30 days (opaque app session; independent of
#                              # the Bangumi access-token lifetime)
